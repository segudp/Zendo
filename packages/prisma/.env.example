# El Prisma CLI (generate/migrate/db seed) busca un .env junto al schema.prisma
# antes que nada, sin importar desde qué carpeta lo invoques. Este archivo existe
# sólo para eso: debe tener el mismo valor que DATABASE_URL en el .env de la raíz.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zendo?schema=public"
