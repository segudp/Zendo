// 05-schema.prisma

// ==========================================
// CONFIGURACIÓN DE PRISMA
// ==========================================
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(version: "3.3")] // Requiere habilitar la extensión en PG
}

// ==========================================
// ENUMS (DOMINIOS Y ESTADOS)
// ==========================================
enum Role {
  SUPER_ADMIN
  COMMERCE_OWNER
  COMMERCE_STAFF
  DRIVER
  CLIENT
}

enum OrderStatus {
  PAYMENT_PENDING
  PENDING
  ACCEPTED
  PREPARING
  READY
  DRIVER_ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

// ==========================================
// DOMINIO: IDENTITY (Usuarios y Seguridad)
// ==========================================
model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  passwordHash   String?
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  phone          String?
  role           Role     @default(CLIENT)
  isActive       Boolean  @default(true) @map("is_active")
  
  // Relaciones
  refreshTokens  RefreshToken[]
  clientOrders   Order[]        @relation("ClientOrders")
  driverProfile  Driver?
  commerce       Commerce?      @relation("CommerceOwner")
  addresses      UserAddress[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)

  @@map("refresh_tokens")
}

// ==========================================
// DOMINIO: LOGISTICS (Geometría y Direcciones)
// ==========================================
model UserAddress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   // Ej: "Casa", "Trabajo"
  address     String
  details     String?
  
  // PostGIS: Punto geográfico exacto
  location    Unsupported("geometry(Point, 4326)")?
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("user_addresses")
}

model Driver {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType    String   @map("vehicle_type") // Moto, Bici, Auto
  plateNumber    String?  @map("plate_number")
  isOnline       Boolean  @default(false) @map("is_online")
  
  // PostGIS: Ubicación en tiempo real para broadcasting
  currentLocation Unsupported("geometry(Point, 4326)")? @map("current_location")
  
  deliveries     OrderDelivery[]

  @@map("drivers")
}

// ==========================================
// DOMINIO: CATALOG (Multi-Tenant)
// ==========================================
model Commerce {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @unique @map("owner_id") @db.Uuid // Relación RBAC
  owner       User     @relation("CommerceOwner", fields: [ownerId], references: [id])
  name        String
  description String?
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  isOpen      Boolean  @default(true) @map("is_open")
  
  address     String
  // PostGIS: Para filtrar comercios cercanos al cliente
  location    Unsupported("geometry(Point, 4326)")?

  // Relaciones Multi-Tenant (El Tenant ID)
  categories  Category[]
  products    Product[]
  orders      Order[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("commerces")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  commerceId  String    @map("commerce_id") @db.Uuid
  commerce    Commerce  @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  name        String
  isActive    Boolean   @default(true) @map("is_active")
  
  products    Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  commerceId  String   @map("commerce_id") @db.Uuid
  commerce    Commerce @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  categoryId  String   @map("category_id") @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id])
  
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  
  orderItems  OrderItem[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("products")
}

// ==========================================
// DOMINIO: TRANSACTING (Pedidos)
// ==========================================
model Order {
  id            String      @id @default(uuid()) @db.Uuid
  commerceId    String      @map("commerce_id") @db.Uuid
  commerce      Commerce    @relation(fields: [commerceId], references: [id])
  clientId      String      @map("client_id") @db.Uuid
  client        User        @relation("ClientOrders", fields: [clientId], references: [id])
  
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(10, 2)
  deliveryFee   Decimal     @map("delivery_fee") @db.Decimal(10, 2)
  
  // Destino
  dropoffAddress String     @map("dropoff_address")
  dropoffLocation Unsupported("geometry(Point, 4326)")? @map("dropoff_location")

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  delivery      OrderDelivery? // Relación 1:1 con la asignación logística

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2) // Congela el precio al momento de compra

  @@map("order_items")
}

// Justificación: Tabla crítica para Auditoría y Resolución de Disputas
model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  notes     String?
  
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("order_status_history")
}

// Justificación: Separa la lógica del pedido de la lógica de entrega (Logística)
model OrderDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId  String   @map("driver_id") @db.Uuid
  driver    Driver   @relation(fields: [driverId], references: [id])
  
  assignedAt DateTime @default(now()) @map("assigned_at")
  pickedUpAt DateTime? @map("picked_up_at")
  deliveredAt DateTime? @map("delivered_at")

  @@map("order_deliveries")
}